# .env.example
# Copy this file to .env.local and fill in your values
# (Do NOT commit .env.local to version control)

# Supabase Free Tier Project Credentials
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Google Gemini API Key for Direct Free Tier Integration
# Obtain free from https://aistudio.google.com/app/apikey
# If omitted, you can enter it in the app's Settings page or use the Supabase Edge Function
VITE_GEMINI_API_KEY=your-gemini-api-key-here
